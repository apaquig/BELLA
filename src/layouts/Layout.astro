---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Carla Romero" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <div class="backdrop"></div>
  <main class="phone">
    <slot />
    
    <footer>
      <a href="#" data-i18n="privacyPolicy">Política de privacidad</a> | 
      <a href="#" data-i18n="terms">Términos</a> | 
      <a href="#" data-i18n="report">Reportar</a>
    </footer>
  </main>

  <script is:inline>
    const CONFIG = {
      nombre: "Carla Romero",
      usuario: "@carlaromero",
      email: "contact@bella.online"
    };

    const TRANSLATIONS = {
      es: {
        title: "Enlaces",
        heroAlt: "Foto principal de Carla Romero",
        bio: "Bienvenido a mi espacio oficial ❤",
        exclusiveCard: "Contenido exclusivo",
        tapHint: " 👆 Toca aquí",
        exclusiveAlt: "Contenido exclusivo",
        digitalPacksCard: "Packs digitales",
        privacyPolicy: "Política de privacidad",
        terms: "Términos",
        report: "Reportar",
        soonTitle: "Muy pronto",
        soonText: "¡Muy pronto más contenido exclusivo para ustedes! Mantente al tanto. ❤",
        soonClose: "Entendido",
        socialInstagram: "Instagram",
        socialTikTok: "TikTok",
        socialX: "X",
        socialThreads: "Threads",
        socialTelegram: "Telegram"
      },
      en: {
        title: "Links",
        heroAlt: "Main photo of Carla Romero",
        bio: "Welcome to my official page ❤",
        exclusiveCard: "Exclusive Content",
        tapHint: " 👆 Tap here",
        exclusiveAlt: "Exclusive content",
        digitalPacksCard: "Digital packs",
        privacyPolicy: "Privacy Policy",
        terms: "Terms of Service",
        report: "Report",
        soonTitle: "Coming Soon",
        soonText: "More exclusive content coming soon for you! Stay tuned. ❤",
        soonClose: "Got it",
        socialInstagram: "Instagram",
        socialTikTok: "TikTok",
        socialX: "X",
        socialThreads: "Threads",
        socialTelegram: "Telegram"
      }
    };

    window.changeLanguage = function(lang) {
      localStorage.setItem("prefLang", lang);

      document.querySelectorAll(".lang-btn").forEach(btn => btn.classList.remove("active"));
      const activeBtn = document.getElementById(`lang-${lang}`);
      if (activeBtn) activeBtn.classList.add("active");

      const dict = TRANSLATIONS[lang];
      if (!dict) return;

      document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (dict[key]) el.textContent = dict[key];
      });

      document.querySelectorAll("[data-i18n-alt]").forEach(el => {
        const key = el.getAttribute("data-i18n-alt");
        if (dict[key]) el.alt = dict[key];
      });

      document.querySelectorAll("[data-i18n-aria-label]").forEach(el => {
        const key = el.getAttribute("data-i18n-aria-label");
        if (dict[key]) el.setAttribute("aria-label", dict[key]);
      });

      document.documentElement.lang = lang;
      document.title = CONFIG.nombre;
    };

    function initLanguage() {
      const saved = localStorage.getItem("prefLang");
      if (saved && TRANSLATIONS[saved]) {
        window.changeLanguage(saved);
      } else {
        const userLang = ((navigator.languages && navigator.languages[0]) || navigator.language || "es").toLowerCase();
        const defaultLang = userLang.startsWith("es") ? "es" : "en";
        window.changeLanguage(defaultLang);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLanguage);
    } else {
      initLanguage();
    }
  </script>
</body>
</html>
